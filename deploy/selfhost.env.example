# 复制为项目根目录的 .env 后填写。.env 已被 .gitignore 忽略，不要提交。

# 正式访问地址（构建时写入前端，改了需要重新 build）
PUBLIC_URL=https://erp.example.com

# 随机长字符串：openssl rand -hex 32
PAYLOAD_SECRET=
POSTGRES_PASSWORD=

# 成员自填 AI 渠道的加密钥匙代次（可选）。默认 k1，只允许字母、数字、- 和 _，最多 32 字。
# 平时不用填。轮换 PAYLOAD_SECRET 时改成新代次（如 k2），并把旧代次放进下面的旧钥匙环。
# 详见 deploy/DEPLOY.md 第 10 节「轮换 PAYLOAD_SECRET（成员 AI 渠道密钥）」。
# AI_CHANNELS_KEY_ID=k1

# 旧代次的钥匙环：JSON 对象，键是旧的 AI_CHANNELS_KEY_ID，值是**当时的 PAYLOAD_SECRET**。
# 只在轮换窗口内设置。轮换脚本确认「升级=0 / 失败=0」之前绝对不能删，
# 否则旧密文解不开，所有成员渠道都会报「密钥无法解密」，只能让用户重新填 key。
# 示例（注意用单引号包住 JSON，docker compose 会原样传进去）：
# AI_CHANNELS_OLD_KEYS='{"k1":"<旧的 PAYLOAD_SECRET>"}'

# 国内加速（可选）
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# NPM_REGISTRY=https://registry.npmmirror.com

# 图片存储：不填 S3_BUCKET 时存在服务器的 media 卷里（简单，记得备份）。
# 阿里云 OSS 示例（S3 兼容）：
# S3_BUCKET=fmkj-media
# S3_REGION=oss-cn-hangzhou
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 腾讯云 COS 示例：S3_REGION=ap-guangzhou  S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com

# 图纸 DWG 转换服务（可选，沿用原配置）
# DWG_CONVERTER_URL=
# DWG_CONVERTER_TOKEN=

# AI 对话密钥（可选；配置后启用侧边栏 AI 与小程序 AI 顾问）
# DeepSeek：https://platform.deepseek.com/
# DEEPSEEK_API_KEY=
# 阿里云百炼 / 通义千问（DashScope）：https://bailian.console.aliyun.com/
# 标准按量付费 key 用「阿里百炼（通义千问）」渠道；
# sk-sp- 开头的 Token Plan 套餐 key 用「阿里百炼 Token Plan」渠道，两者共用这个变量。
# 注意：北京地域与国际地域的 Key 不通用，本渠道固定使用北京地域地址。
# DASHSCOPE_API_KEY=

# AI 生图（/ai/image）与自定义渠道「阿里云百炼 Token Plan」用的密钥。
# 不填时生图页会提示「服务器尚未配置 AI_BAILIAN_TOKEN_PLAN_KEY」。
# 想用 Token Plan 跑聊天模型，还需要在后台「设置 → AI 设置 → 自定义渠道」里
# 添加一条 key=bailian-tokenplan、apiKeyEnv=AI_BAILIAN_TOKEN_PLAN_KEY 的渠道，
# 再把模型指向它（内置的「阿里百炼 Token Plan」渠道读的是 DASHSCOPE_API_KEY）。
# AI_BAILIAN_TOKEN_PLAN_KEY=

# 微信小程序（启用微信一键登录时必填；AppSecret 只放服务端）
# WECHAT_MP_APPID=
# WECHAT_MP_SECRET=

# 邮箱验证码发信（启用注册验证码与忘记密码重置时填写；支持腾讯企业邮、QQ邮箱、阿里云企业邮、163 等 465 SSL SMTP）
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=邮箱客户端专用密码或授权码
# SMTP_FROM=no-reply@example.com

# 生产固定走 src/migrations 迁移；PAYLOAD_DB_PUSH 只对本地开发（NODE_ENV != production）生效
# PAYLOAD_DB_PUSH=false

# 桌面客户端安装包放在对象存储 / CDN 时填写公开地址前缀（可选）。
# 默认读取项目目录下的 desktop-releases/（docker-compose 已挂载），本地没有的文件会跳转到这里。
# DESKTOP_RELEASES_URL=https://cdn.example.com/desktop
