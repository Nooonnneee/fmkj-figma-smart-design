.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-panel {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 28rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #171717;
  text-align: center;
}

.privacy-text {
  margin-top: 24rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #52525b;
}

.privacy-link {
  color: #2563eb;
}

.privacy-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-ghost {
  background: #f4f4f5;
  color: #52525b;
}

.privacy-btn-primary {
  background: #171717;
  color: #ffffff;
}
