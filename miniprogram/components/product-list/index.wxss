.cats { white-space: nowrap; margin-top: 20rpx; display: flex; gap: 12rpx; }
.cats .chip { margin-right: 12rpx; }
.mt-20 { margin-top: 20rpx; }
.sort-bar { display: inline-flex; align-items: center; gap: 4rpx; padding: 4rpx; border-radius: 14rpx; background: var(--paper-muted); }
.sort-item { height: 48rpx; line-height: 48rpx; padding: 0 18rpx; border-radius: 10rpx; font-size: 22rpx; color: var(--pencil); }
.sort-item.active { background: var(--paper); color: var(--ink); font-weight: 600; box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.08); }
