<view class="page">
  <view class="row between">
    <view class="grow">
      <view class="label">{{greeting}}</view>
      <view class="h1 truncate">{{me.name || '欢迎回来'}}</view>
    </view>
    <view class="credits" hover-class="btn-hover" bindtap="toAi">
      <image class="icon-sm" src="/assets/icons/sparkles.svg" />
      <text class="num">{{me.aiCredits || 0}}</text>
      <text class="small muted">积分</text>
    </view>
  </view>

  <view class="stats mt-32">
    <view class="stat" hover-class="list-item-hover" bindtap="toProjects">
      <text class="label">进行中项目</text>
      <text class="num">{{stats.activeProjects || 0}}</text>
    </view>
    <view class="stat">
      <text class="label">待确认报价</text>
      <text class="num">{{stats.sentQuotes || 0}}</text>
    </view>
    <view class="stat">
      <text class="label">待签合同</text>
      <text class="num">{{stats.draftContracts || 0}}</text>
    </view>
  </view>

  <view class="quick mt-24">
    <view class="quick-item" hover-class="list-item-hover" bindtap="newProject">
      <view class="quick-icon"><image class="icon" src="/assets/icons/plus.svg" /></view>
      <text class="small">新建项目</text>
    </view>
    <view class="quick-item" hover-class="list-item-hover" bindtap="aiFloorPlan">
      <view class="quick-icon"><image class="icon" src="/assets/icons/image-plus.svg" /></view>
      <text class="small">户型图识别</text>
    </view>
    <view class="quick-item" hover-class="list-item-hover" bindtap="toAi">
      <view class="quick-icon"><image class="icon" src="/assets/icons/sparkles.svg" /></view>
      <text class="small">AI 助手</text>
    </view>
    <view class="quick-item" hover-class="list-item-hover" bindtap="toProducts">
      <view class="quick-icon"><image class="icon" src="/assets/icons/package.svg" /></view>
      <text class="small">产品库</text>
    </view>
    <view class="quick-item" hover-class="list-item-hover" bindtap="scanWebLogin">
      <view class="quick-icon"><image class="icon" src="/assets/icons/maximize.svg" /></view>
      <text class="small">扫码登录电脑</text>
    </view>
  </view>

  <view class="section-title">
    <text class="title">最近项目</text>
    <view class="row gap-8 small muted" bindtap="toProjects">全部<image class="icon-sm" src="/assets/icons/chevron-right-muted.svg" /></view>
  </view>
  <view class="card card-flush">
    <view wx:for="{{recentProjects}}" wx:key="id" class="list-item" hover-class="list-item-hover" data-id="{{item.id}}" bindtap="openProject">
      <view class="grow">
        <view class="title truncate">{{item.name}}</view>
        <view class="small muted mt-8 truncate">{{item.metaLine}}</view>
      </view>
      <image class="icon-sm" src="/assets/icons/chevron-right-muted.svg" />
    </view>
    <view wx:if="{{!loading && !recentProjects.length}}" class="empty">
      <image class="icon-lg" src="/assets/icons/folder-muted.svg" />
      <text>还没有进行中的项目</text>
      <button class="btn btn-primary btn-sm" hover-class="btn-hover" bindtap="newProject">新建项目</button>
    </view>
  </view>

  <block wx:if="{{recentQuotes.length}}">
    <view class="section-title"><text class="title">最近报价</text></view>
    <view class="card card-flush">
      <view wx:for="{{recentQuotes}}" wx:key="id" class="list-item" hover-class="list-item-hover" data-id="{{item.id}}" bindtap="openQuote">
        <view class="grow">
          <view class="truncate">{{item.title}}</view>
          <view class="small muted mt-8 truncate">{{item.projectName || '未关联项目'}} · {{item.time}}</view>
        </view>
        <view class="text-right shrink-0">
          <view class="num">{{item.totalText}}</view>
          <view class="badge {{item.badge}} mt-8">{{item.statusLabel}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
<privacy-popup id="privacy-popup" />
