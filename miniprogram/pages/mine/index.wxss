.stats.two { grid-template-columns: repeat(2, 1fr); }
.tier-sheet-body { max-height: 72vh; }
.tier-list { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 24rpx; }
.tier-card { border: 1rpx solid var(--rule); border-radius: 24rpx; padding: 24rpx; background: var(--paper); }
.tier-pro { border-color: var(--ink-primary); background: #fafafa; }
.tier-title { font-size: 28rpx; font-weight: 600; }
.tier-perks { display: flex; flex-direction: column; gap: 8rpx; font-size: 24rpx; color: var(--ink); }
.tier-perk { line-height: 1.45; }
