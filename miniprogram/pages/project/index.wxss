.kv { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; padding: 16rpx 0; border-top: 1rpx solid var(--rule); }
.kv:first-child { border-top: none; }
.progress-wrap { padding: 16rpx 20rpx; border-radius: 16rpx; background: var(--paper-muted); }
.step-labels { display: flex; justify-content: space-between; }
.ai-entry { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: var(--paper-muted); border: 1rpx solid var(--rule); font-weight: 500; }
.mini-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.mini-stats .num { font-size: 34rpx; margin-top: 4rpx; }
.block { display: block; }

/* 交付方案模板 */
.tpl-card { display: flex; align-items: center; gap: 24rpx; margin-bottom: 0; }
.tpl-cover { width: 200rpx; height: 134rpx; border-radius: 16rpx; flex-shrink: 0; background: var(--paper-muted); border: 1rpx solid var(--rule); }
.tpl-meta { min-width: 0; }
.tpl-actions + .card { margin-top: 24rpx; }
.tpl-item { position: relative; display: flex; gap: 24rpx; padding: 24rpx; margin-top: 20rpx; border: 1rpx solid var(--rule); border-radius: 24rpx; background: var(--paper); }
.tpl-item-active { border-color: var(--ink-primary); box-shadow: 0 0 0 2rpx var(--ink-primary) inset; }
.tpl-thumb { width: 220rpx; height: 147rpx; border-radius: 14rpx; flex-shrink: 0; background: var(--paper-muted); border: 1rpx solid var(--rule); }
.tpl-item .tpl-meta { padding-bottom: 64rpx; }
.tpl-name { font-size: 30rpx; font-weight: 600; }
.tpl-tag { display: inline-flex; align-items: center; height: 40rpx; padding: 0 14rpx; border-radius: 10rpx; background: var(--paper-muted); color: var(--pencil); font-size: 22rpx; }
.tpl-lock { width: 22rpx; height: 22rpx; }
.tpl-preview { position: absolute; right: 20rpx; bottom: 20rpx; height: 52rpx; line-height: 52rpx; padding: 0 22rpx; border-radius: 999rpx; border: 1rpx solid var(--rule); background: var(--paper); font-size: 24rpx; }
