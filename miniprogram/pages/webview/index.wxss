.fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 80rpx 56rpx;
  text-align: center;
}
.fallback-emoji { font-size: 72rpx; margin-bottom: 24rpx; }
.fallback-title { font-size: 34rpx; font-weight: 600; color: #171717; }
.fallback-desc { margin-top: 16rpx; font-size: 26rpx; line-height: 1.7; color: #71717a; }
.fallback-actions { display: flex; gap: 24rpx; margin-top: 48rpx; }
.fallback-btn { margin: 0; }
.fallback-btn.primary { background: #171717; color: #ffffff; }
